(function() {
  const ALL_MONTHS = [
    'Jan-23','Feb-23','Mar-23','Apr-23','May-23','Jun-23',
    'Jul-23','Aug-23','Sep-23','Oct-23','Nov-23','Dec-23',
    'Jan-24','Feb-24','Mar-24','Apr-24','May-24','Jun-24',
    'Jul-24','Aug-24','Sep-24','Oct-24','Nov-24','Dec-24',
    'Jan-25','Feb-25','Mar-25','Apr-25','May-25','Jun-25',
    'Jul-25','Aug-25','Sep-25','Oct-25','Nov-25','Dec-25',
    'Jan-26','Feb-26','Mar-26','Apr-26','May-26','Jun-26','Jul-26'
  ];
  const MAX_IDX = ALL_MONTHS.length - 1;

  // Map our data months to ALL_MONTHS indices
  function monthToIdx(m) { return ALL_MONTHS.indexOf(m); }

  const track = document.getElementById('time-slider-track');
  const startInput = document.getElementById('slider-start');
  const endInput = document.getElementById('slider-end');
  const thumbStart = document.getElementById('thumb-start');
  const thumbEnd = document.getElementById('thumb-end');
  const startLabel = document.getElementById('slider-start-label');
  const endLabel = document.getElementById('slider-end-label');
  const rangeFill = document.getElementById('slider-range-fill');

  if (!track) return;

  startInput.max = MAX_IDX;
  endInput.max = MAX_IDX;
  // Default: Jul-24 to Jul-26
  startInput.value = monthToIdx('Jul-24') >= 0 ? monthToIdx('Jul-24') : 18;
  endInput.value = MAX_IDX;

  function formatLabel(idx) {
    const m = ALL_MONTHS[idx] || '';
    const [mon, yr] = m.split('-');
    return mon + ' 20' + yr;
  }

  function updateSliderUI() {
    const sVal = parseInt(startInput.value);
    const eVal = parseInt(endInput.value);
    const sPos = (sVal / MAX_IDX) * 100;
    const ePos = (eVal / MAX_IDX) * 100;
    thumbStart.style.left = sPos + '%';
    thumbEnd.style.left = ePos + '%';
    rangeFill.style.left = sPos + '%';
    rangeFill.style.right = (100 - ePos) + '%';
    startLabel.textContent = formatLabel(sVal);
    endLabel.textContent = formatLabel(eVal);
  }

  function applyTimeFilter() {
    const fullTotal = RAW_DATA.sentiment_overall.positive + RAW_DATA.sentiment_overall.negative + RAW_DATA.sentiment_overall.neutral;
    const sVal = parseInt(startInput.value);
    const eVal = parseInt(endInput.value);
    const startMonth = ALL_MONTHS[sVal];
    const endMonth = ALL_MONTHS[eVal];


    // Ensure all tab charts are pre-initialized so filter updates work even before tab is clicked
    if (!chartRegistry['csat-trend']) initTab2Charts();
    if (!chartRegistry['gaps-bubble']) initTab3Charts();
    if (!document.getElementById('csofFeaturesChart2')?._csof2Init) initCSoFCharts();
    // Filter monthly trend chart
    const mt = RAW_DATA.monthly_trend;
    const filteredIndices = mt.months.reduce((acc, m, i) => {
      const idx = monthToIdx(m);
      if (idx >= sVal && idx <= eVal) acc.push(i);
      return acc;
    }, []);
    const fMonths = filteredIndices.map(i => mt.months[i]);
    const fPos = filteredIndices.map(i => mt.positive[i]);
    const fNeg = filteredIndices.map(i => mt.negative[i]);
    const fNeu = filteredIndices.map(i => mt.neutral[i]);

    if (chartRegistry['monthly-trend']) {
      const chart = chartRegistry['monthly-trend'];
      chart.data.labels = fMonths;
      chart.data.datasets[0].data = fPos;
      chart.data.datasets[1].data = fNeg;
      chart.data.datasets[2].data = fNeu;
      chart.update();
    }

    // Filter CSAT trend chart
    const ct = RAW_DATA.csat_trend;
    const csatIndices = ct.months.reduce((acc, m, i) => {
      const idx = monthToIdx(m);
      if (idx >= sVal && idx <= eVal) acc.push(i);
      return acc;
    }, []);
    if (chartRegistry['csat-trend']) {
      const chart = chartRegistry['csat-trend'];
