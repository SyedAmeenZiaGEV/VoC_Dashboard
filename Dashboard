          featureChart.data.datasets[0].backgroundColor = baseRatings.map(r =>
            r >= 4.0 ? `rgba(0,212,170,${opacity.toFixed(2)})` :
            r >= 3.0 ? `rgba(255,211,42,${opacity.toFixed(2)})` :
                       `rgba(255,71,87,${opacity.toFixed(2)})`
          );
        }
        featureChart.update();
      }
    }

    // Update CSOF KPI cards (CSOF tab) — research period is Feb-May 2026 (indices for Feb-26 to May-26)
    const csofStart = monthToIdx('Feb-26');
    const csofEnd = monthToIdx('May-26');
    const csofOverlaps = sVal <= csofEnd && eVal >= csofStart;
    const csofInterviewsEl = document.getElementById('csof-kpi-interviews');
    const csofDimsEl = document.getElementById('csof-kpi-dims');
    const csofRatingEl = document.getElementById('csof-kpi-rating');
    const csofPeriodEl = document.getElementById('csof-kpi-period');
    if (csofInterviewsEl) csofInterviewsEl.textContent = csofOverlaps ? '29' : '—';
    if (csofDimsEl) csofDimsEl.textContent = csofOverlaps ? '74' : '—';
    if (csofRatingEl) csofRatingEl.innerHTML = csofOverlaps ? '4.2<span style="font-size:14px;color:#7a8aaa">/5</span>' : '<span style="font-size:16px;color:#7a8aaa">Outside range</span>';
    if (csofPeriodEl) csofPeriodEl.style.opacity = csofOverlaps ? '1' : '0.4';
  }

  // Drag logic for both thumbs
  let dragging = null;
  function onMouseDown(e, which) {
    e.preventDefault();
    dragging = which;
  }
  function onMouseMove(e) {
    if (!dragging) return;
    const rect = track.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    let pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    let idx = Math.round(pct * MAX_IDX);
    if (dragging === 'start') {
      idx = Math.min(idx, parseInt(endInput.value) - 1);
      startInput.value = idx;
    } else {
      idx = Math.max(idx, parseInt(startInput.value) + 1);
      endInput.value = idx;
    }
    updateSliderUI();
    applyTimeFilter();
  }
  function onMouseUp() { dragging = null; }

  thumbStart.addEventListener('mousedown', e => onMouseDown(e, 'start'));
  thumbEnd.addEventListener('mousedown', e => onMouseDown(e, 'end'));
  thumbStart.addEventListener('touchstart', e => onMouseDown(e, 'start'), {passive:false});
  thumbEnd.addEventListener('touchstart', e => onMouseDown(e, 'end'), {passive:false});
  document.addEventListener('mousemove', onMouseMove);
  document.addEventListener('touchmove', onMouseMove, {passive:false});
  document.addEventListener('mouseup', onMouseUp);
  document.addEventListener('touchend', onMouseUp);

  updateSliderUI();
})();

</script>
</body>
</html>
