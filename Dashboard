<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GE Vernova VOC Intelligence Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
/* ============================================================
   GE VERNOVA DESIGN SYSTEM CSS — VERBATIM
============================================================ */
:root {
  --color-dk1:      #005E60;
  --color-lt1:      #FFFFFF;
  --color-dk2:      #212121;
  --color-lt2:      #C8FF08;
  --color-accent1:  #004745;
  --color-accent6:  #458A8A;
  --color-tint-2:   #96BDBD;
  --color-tint-3:   #C7DBDB;
  --color-gray-1:   #FAFAFA;
  --color-accent2:  #E3E3E3;
  --color-accent3:  #CCCCCC;
  --color-accent4:  #696969;
  --color-accent5:  #484848;
  --color-hlink:      #2176FF;
  --color-sky:        #5FB7FF;
  --color-fol-hlink:  #3E9E00;
  --color-forest:     #7BDD3C;
  --color-dark-earth: #4A2419;
  --color-earth:      #774936;
  --font-heading: "Sons Condensed Extrabold", "Inter", "Segoe UI", sans-serif;
  --font-body:    "Inter", "Segoe UI", sans-serif;
}

/* ============================================================
   DASHBOARD OVERRIDES — VOC INTELLIGENCE THEME
============================================================ */
* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Inter', 'Segoe UI', sans-serif;
  background: #0a0e1a;
  color: #e0e6f0;
  min-height: 100vh;
  font-size: 14px;
  line-height: 1.5;
}

/* SCROLLBAR */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: #0a0e1a; }
::-webkit-scrollbar-thumb { background: #1a2744; border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: #00a3e0; }

/* HEADER */
.dash-header {
  background: #0d1526;
  border-bottom: 1px solid #1a2744;
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16px;
}

.gev-logo {
  height: 32px;
  width: auto;
}

.header-divider {
  width: 1px;
  height: 36px;
  background: #1a2744;
}

.header-title h1 {
  font-size: 16px;
  font-weight: 700;
  color: #e0e6f0;
  letter-spacing: 0.5px;
}

.header-title p {
  font-size: 11px;
  color: #00d4aa;
  font-weight: 500;
  letter-spacing: 0.3px;
}

.kpi-chips {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}

.kpi-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.04);
  border: 1px solid #1a2744;
  border-radius: 8px;
  padding: 6px 12px;
  min-width: 80px;
}

.kpi-chip .chip-val {
  font-size: 15px;
  font-weight: 700;
  line-height: 1.2;
}

.kpi-chip .chip-lbl {
  font-size: 9px;
  color: #7a8aaa;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  white-space: nowrap;
}

.kpi-chip .chip-caption { font-size: 8px; color: #4a5a7a; font-style: italic; text-align: center; max-width: 90px; line-height: 1.2; margin-top: 1px; }

.dynamic-badge {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  background: rgba(0,163,224,0.12);
  border: 1px solid rgba(0,163,224,0.3);
  border-radius: 4px;
  padding: 1px 6px;
  font-size: 9px;
  font-weight: 700;
  color: #00a3e0;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  vertical-align: middle;
  margin-left: 6px;
  white-space: nowrap;
  flex-shrink: 0;
}

/* TABS */
.tab-bar {
  background: #0d1526;
  border-bottom: 1px solid #1a2744;
  padding: 0 24px;
  display: flex;
  gap: 0;
  overflow-x: auto;
}

.tab-btn {
  background: none;
  border: none;
  border-bottom: 3px solid transparent;
  color: #7a8aaa;
  padding: 12px 18px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
  font-family: inherit;
}

.tab-btn:hover { color: #e0e6f0; }

.tab-btn.active {
  color: #00a3e0;
  border-bottom-color: #00a3e0;
  font-weight: 600;
}

/* FILTERS BAR */
.filters-bar {
  background: #0d1526;
  border-bottom: 1px solid #1a2744;
  padding: 10px 24px;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.filter-group {
  display: flex;
  align-items: center;
  gap: 6px;
}

.filter-label {
  font-size: 11px;
  color: #7a8aaa;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  white-space: nowrap;
}

.filter-select {
  background: #0a0e1a;
  border: 1px solid #1a2744;
  border-radius: 6px;
  color: #e0e6f0;
  padding: 5px 10px;
  font-size: 12px;
  font-family: inherit;
  cursor: pointer;
  outline: none;
  transition: border-color 0.2s;
}

.filter-select:focus { border-color: #00a3e0; }

.btn-apply {
  background: #00a3e0;
  border: none;
  border-radius: 6px;
  color: #fff;
  padding: 6px 14px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  transition: background 0.2s;
}

.btn-apply:hover { background: #0088bb; }

.btn-reset {
  background: transparent;
  border: 1px solid #1a2744;
  border-radius: 6px;
  color: #7a8aaa;
  padding: 6px 14px;
  font-size: 12px;
  cursor: pointer;
  font-family: inherit;
  transition: all 0.2s;
}

.btn-reset:hover { border-color: #7a8aaa; color: #e0e6f0; }

/* MAIN CONTENT */
.main-content {
  padding: 20px 24px;
  max-width: 1600px;
  margin: 0 auto;
}

/* TAB PANELS */
.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* DATA BANNER */
.data-banner {
  background: rgba(0,163,224,0.08);
  border: 1px solid rgba(0,163,224,0.2);
  border-radius: 8px;
  padding: 10px 16px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  color: #7a8aaa;
}

.data-banner .banner-icon { color: #00a3e0; font-size: 16px; }

/* GRID LAYOUTS */
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 20px; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
.grid-2-1 { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 20px; }
.grid-1-2 { display: grid; grid-template-columns: 1fr 2fr; gap: 16px; margin-bottom: 20px; }

@media (max-width: 1100px) {
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: repeat(2, 1fr); }
  .grid-2, .grid-2-1, .grid-1-2 { grid-template-columns: 1fr; }
}

@media (max-width: 600px) {
  .grid-4, .grid-3 { grid-template-columns: 1fr; }
  .main-content { padding: 12px; }
  .dash-header { padding: 10px 12px; }
  .kpi-chips { gap: 4px; }
  .kpi-chip { min-width: 60px; padding: 4px 8px; }
}

/* CARDS */
.card {
  background: #0d1526;
  border: 1px solid #1a2744;
  border-radius: 12px;
  padding: 16px;
  position: relative;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.card-title {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  color: #7a8aaa;
}

.info-btn {
  background: none;
  border: 1px solid #1a2744;
  border-radius: 50%;
  width: 22px;
  height: 22px;
  color: #7a8aaa;
  font-size: 11px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  position: relative;
}

.info-btn:hover { border-color: #00a3e0; color: #00a3e0; }

.info-tooltip {
  display: none;
  position: absolute;
  top: 28px;
  right: 0;
  background: #1a2744;
  border: 1px solid #2a3754;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 11px;
  color: #7a8aaa;
  white-space: nowrap;
  z-index: 50;
  min-width: 200px;
}

.info-btn:hover .info-tooltip { display: block; }

/* STAT CARDS */
.stat-card {
  background: #0d1526;
  border: 1px solid #1a2744;
  border-radius: 12px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.stat-card .stat-label {
  font-size: 11px;
  color: #7a8aaa;
  text-transform: uppercase;
  letter-spacing: 0.6px;
}

.stat-card .stat-value {
  font-size: 28px;
  font-weight: 700;
  line-height: 1.1;
}

.stat-card .stat-sub {
  font-size: 12px;
  color: #7a8aaa;
}

.stat-card .stat-bar {
  height: 3px;
  border-radius: 2px;
  margin-top: 4px;
}

/* CHART WRAPPERS */
.chart-canvas-wrapper {
  position: relative;
  width: 100%;
}

.chart-canvas-wrapper.h280 { height: 280px; }
.chart-canvas-wrapper.h200 { height: 200px; }
.chart-canvas-wrapper.h240 { height: 240px; }
.chart-canvas-wrapper.h320 { height: 320px; }
.chart-canvas-wrapper.h360 { height: 360px; }
.chart-canvas-wrapper.h400 { height: 400px; }

/* TABLES */
.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.data-table th {
  background: rgba(255,255,255,0.04);
  color: #7a8aaa;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-size: 10px;
  padding: 10px 12px;
  text-align: left;
  border-bottom: 1px solid #1a2744;
  white-space: nowrap;
}

.data-table td {
  padding: 10px 12px;
  border-bottom: 1px solid rgba(26,39,68,0.5);
  color: #e0e6f0;
  vertical-align: middle;
}

.data-table tr:hover td { background: rgba(255,255,255,0.02); }

/* BADGES */
.badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.badge-green { background: rgba(0,212,170,0.15); color: #00d4aa; border: 1px solid rgba(0,212,170,0.3); }
.badge-red { background: rgba(255,71,87,0.15); color: #ff4757; border: 1px solid rgba(255,71,87,0.3); }
.badge-orange { background: rgba(255,165,0,0.15); color: #ffa500; border: 1px solid rgba(255,165,0,0.3); }
.badge-yellow { background: rgba(255,211,42,0.15); color: #ffd32a; border: 1px solid rgba(255,211,42,0.3); }
.badge-blue { background: rgba(0,163,224,0.15); color: #00a3e0; border: 1px solid rgba(0,163,224,0.3); }
.badge-purple { background: rgba(179,102,255,0.15); color: #b366ff; border: 1px solid rgba(179,102,255,0.3); }

/* NPS CARDS */
.nps-summary {
  display: flex;
  gap: 12px;
  margin-top: 12px;
  flex-wrap: wrap;
}

.nps-box {
  flex: 1;
  min-width: 80px;
  background: rgba(255,255,255,0.03);
  border: 1px solid #1a2744;
  border-radius: 8px;
  padding: 10px;
  text-align: center;
}

.nps-box .nps-pct { font-size: 20px; font-weight: 700; }
.nps-box .nps-lbl { font-size: 10px; color: #7a8aaa; margin-top: 2px; }

/* VERBATIM QUOTES */
.quote-card {
  background: rgba(255,255,255,0.02);
  border-left: 3px solid #00a3e0;
  border-radius: 0 8px 8px 0;
  padding: 10px 14px;
  margin-bottom: 10px;
  font-size: 12px;
  color: #c0cce0;
  font-style: italic;
}

.quote-card .quote-meta {
  font-style: normal;
  font-size: 10px;
  color: #7a8aaa;
  margin-top: 6px;
}

/* PHASE CARDS */
.phase-card {
  border-radius: 12px;
  padding: 18px;
  border: 1px solid;
}

.phase-card h3 {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 8px;
}

.phase-card ul {
  list-style: none;
  padding: 0;
}

.phase-card ul li {
  font-size: 12px;
  padding: 4px 0;
  color: #c0cce0;
  display: flex;
  align-items: flex-start;
  gap: 6px;
}

.phase-card ul li::before { content: '▸'; flex-shrink: 0; }

/* OPPORTUNITY CARDS */
.opp-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid #1a2744;
  border-radius: 10px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.opp-card .opp-title { font-size: 13px; font-weight: 600; color: #e0e6f0; }
.opp-card .opp-score { font-size: 22px; font-weight: 700; }
.opp-card .opp-desc { font-size: 11px; color: #7a8aaa; }

/* FOOTER */
.dash-footer {
  background: #0d1526;
  border-top: 1px solid #1a2744;
  padding: 12px 24px;
  text-align: center;
  font-size: 11px;
  color: #7a8aaa;
  margin-top: 40px;
}

/* LEGEND */
.chart-legend {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  color: #7a8aaa;
}

.legend-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-rect {
  width: 14px;
  height: 8px;
  border-radius: 2px;
  flex-shrink: 0;
}

/* SECTION TITLE */
.section-title {
  font-size: 13px;
  font-weight: 700;
  color: #e0e6f0;
  margin-bottom: 16px;
  padding-bottom: 8px;
  border-bottom: 1px solid #1a2744;
  display: flex;
  align-items: center;
  gap: 8px;
}

.section-title .section-icon { color: #00a3e0; }

/* COUNTER ANIMATION */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.stat-card, .card { animation: fadeInUp 0.4s ease both; }

/* SCROLLABLE TABLE WRAPPER */
.table-wrapper {
  overflow-x: auto;
  border-radius: 8px;
  border: 1px solid #1a2744;
}

/* QUADRANT LABELS */
.quadrant-label {
  position: absolute;
  font-size: 10px;
  color: rgba(122,138,170,0.5);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  pointer-events: none;
}

/* PROGRESS BAR */
.progress-bar-wrap {
  background: rgba(255,255,255,0.05);
  border-radius: 4px;
  height: 6px;
  overflow: hidden;
  margin-top: 4px;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 4px;
  transition: width 1s ease;
}

/* INLINE METRIC */
.inline-metric {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid rgba(26,39,68,0.5);
}

.inline-metric:last-child { border-bottom: none; }
.inline-metric .im-label { font-size: 12px; color: #c0cce0; }
.inline-metric .im-value { font-size: 13px; font-weight: 600; }

/* CSAT STAR */
.csat-stars { color: #ffd32a; font-size: 14px; letter-spacing: 2px; }

/* RESPONSIVE ADJUSTMENTS */
@media (max-width: 900px) {
  .kpi-chips { display: none; }
}

/* TIME RANGE SLIDER */
#time-slider-track input[type=range] { -webkit-appearance:none; appearance:none; }
#time-slider-track input[type=range]::-webkit-slider-thumb { -webkit-appearance:none; width:14px; height:14px; border-radius:50%; background:#00a3e0; cursor:grab; pointer-events:all; }
#time-slider-track input[type=range]::-moz-range-thumb { width:14px; height:14px; border-radius:50%; background:#00a3e0; cursor:grab; pointer-events:all; border:none; }
.thumb-handle { position:absolute; width:14px; height:14px; background:#00a3e0; border:2px solid #0d1526; border-radius:50%; top:50%; transform:translate(-50%,-50%); cursor:grab; z-index:4; }
.thumb-handle:active { cursor:grabbing; background:#0088bb; }
</style>
</head>
