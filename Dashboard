function buildProductTable() {
  const tbody = document.getElementById('product-table-body');
  if (!tbody) return;
  const pd = RAW_DATA.prompt_sentiment;
  const sorted = Object.keys(pd).sort((a,b) => pd[b].pos - pd[a].pos);
  tbody.innerHTML = sorted.map(k => {
    const d = pd[k];
    let status, badgeClass;
    if (d.pos > 45) { status='STRONG'; badgeClass='badge-green'; }
    else if (d.neg > 35) { status='CRITICAL'; badgeClass='badge-red'; }
    else if (d.neg > 30) { status='AT RISK'; badgeClass='badge-orange'; }
    else { status='MIXED'; badgeClass='badge-yellow'; }
    return `<tr>
      <td style="font-weight:600;color:#e0e6f0">${k}</td>
      <td>${d.total.toLocaleString()}</td>
      <td style="color:#00d4aa">${d.pos}%</td>
      <td style="color:#ff4757">${d.neg}%</td>
      <td style="color:#ffd32a">${d.neu}%</td>
      <td style="color:#ffa500">${d.csat.toFixed(2)}</td>
      <td><span class="badge ${badgeClass}">${status}</span></td>
    </tr>`;
  }).join('');
}

